# 줄 모양으로 뜻을 나눈다. 키를 두고 값만 비우면 '미설정'이 아니라 빈 문자열이 들어가 application.yaml 의
# ${VAR:default} 기본값이 적용되지 않는다(로컬은 spring.config.import, 배포는 compose env_file 로 결과가 같다).
#   KEY=       필수. 기본값이 없는 키, 또는 채워야 켜지는 연동 키(비우면 꺼짐)라 환경마다 채운다.
#   KEY=값     명시 권장. 환경마다 값을 정해 두는 스위치라 지우거나 비우지 않는다.
#   # KEY=값   기본값 사용. 쓸 때만 주석을 푼다(적힌 값은 따로 적지 않았으면 yaml 기본값).
# 값 뒤에 # 주석을 붙이지 않는다 — 로컬은 # 뒤까지 값으로 읽는다.

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 간편가입 약관 목록의 '마케팅 수신 동의' 항목 태그. 기본값이 지금 콘솔 등록값이다 — 콘솔 태그를 바꿨을 때만 주석을 풀어 맞춘다.
# KAKAO_MARKETING_TERM_TAG=marketing-consent

# 관리자 계정 부트스트랩 (AdminAccountInitializer — 기동 시 해당 loginId 가 없으면 생성, 비우면 건너뛴다)
# 비밀번호 12자 이상 권장, 72바이트(BCrypt 한계) 이하 필수.
ADMIN_LOGIN_ID=
ADMIN_PASSWORD=

# 네이티브 앱 로그인 (iOS)
# 카카오 앱 로그인 결과를 돌려보낼 https 주소 — 그 환경의 웹 도메인 + /login/app
#   예) https://staging.buncheoleasy.com/login/app · https://buncheoleasy.com/login/app
# 비우면 앱 카카오 로그인이 꺼진다(기본). 웹의 애플 연결 파일(/.well-known/apple-app-site-association)에 적힌 앱만 받는다.
# ⚠️ 커스텀 스킴(buncheoleasy://)은 다른 앱이 가로챌 수 있어(RFC 8252 §8.6) https 가 아니면 기동 실패.
APP_LOGIN_CALLBACK_URL=
# 애플 로그인 토큰의 aud 로 허용할 앱 번들 ID(쉼표 목록). 비어 있으면 애플 로그인을 거절한다(400 AUTH-010).
APPLE_SIGNIN_AUDIENCES=

# JWT
JWT_ACCESS_KEY=
JWT_REFRESH_KEY=

# AWS S3
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
# S3_BUCKET=buncheol-easy-bucket

# Delivery Tracker 운송장 자동 추적 (console.tracker.delivery 에서 발급)
# ⚠️ 세 값(클라이언트 ID/시크릿 + 웹훅 토큰)이 모두 있어야 자동 추적이 켜진다 — 비워두면 조회·웹훅 등록을
# 건너뛰고 기존 참여자 수동 수령확인으로만 동작한다.
DELIVERY_TRACKER_CLIENT_ID=
DELIVERY_TRACKER_CLIENT_SECRET=
# 추적 콜백 발신자 검증용 공유 비밀값 (임의 랜덤 문자열, 예: openssl rand -hex 24)
DELIVERY_TRACKER_WEBHOOK_TOKEN=
# 콜백 수신 URL. 비우면 자동 추적이 꺼진다. staging/prod 는 반드시 실제 도메인으로 채운다.
# ⚠️ https 필수 — http URL 은 Delivery Tracker 가 웹훅 등록 자체를 거절한다(BAD_REQUEST).
# ⚠️ 검증 토큰이 URL 쿼리로 오가므로 리버스 프록시(nginx/ALB) 액세스 로그의 쿼리스트링 마스킹을 권장.
#   토큰 유출 의심 시 env 만 교체하면 갱신 스케줄러가 1주기 내 전 웹훅을 새 토큰으로 재등록한다.
#   예) https://<운영 도메인>/v1/deliveries/webhook/callback
DELIVERY_TRACKER_CALLBACK_URL=
# 아웃바운드 호출 간 최소 간격 (기본 200ms = 초당 5콜, 쿼터 초당 10콜의 절반).
# DELIVERY_TRACKER_MIN_CALL_INTERVAL=200ms

# Database
# DB_URL: 전체 JDBC URL(호스트 포함). RDS 사용(staging/prod) 시 주석을 풀고 RDS endpoint로 직접 지정.
#   예) jdbc:mysql://<RDS_ENDPOINT>:3306/<DB_NAME>?serverTimezone=UTC&characterEncoding=UTF-8
#   미설정 시 application.yaml 기본값(localhost)로 fallback 되므로 RDS 환경에서는 반드시 채운다.
# DB_URL=jdbc:mysql://localhost:3306/buncheoleasy_db?serverTimezone=UTC&characterEncoding=UTF-8
# MYSQL_ROOT_PASSWORD / MYSQL_DATABASE: local Docker Compose(내장 mysql 컨테이너) 전용.
#   staging/prod(RDS)에서는 불필요 — DB 접속은 DB_URL / DB_USERNAME / DB_PASSWORD 로만 한다.
MYSQL_ROOT_PASSWORD=
# MYSQL_DATABASE=buncheoleasy_db
# DB_USERNAME: staging/prod(RDS)는 주석을 풀고 채운다.
# DB_USERNAME=root
DB_PASSWORD=

# Frontend / Admin Base URL / CORS
# 주석 줄은 로컬 기본값(localhost)이다. staging/prod 에서는 주석을 풀고 반드시 실제 도메인 값으로 채운다 — 빠뜨리면 localhost 로 조용히 fallback 된다.
# 로컬은 주석 그대로 두면 프론트 dev 서버 포트 3001 기준이다(3000 은 Grafana 터널용). 3000 값이 남아 있으면 로그인 후 엉뚱한 곳으로 돌아간다.
# FRONTEND_BASE_URL: 프론트 웹앱 origin. 알림톡 버튼 URL의 base 로 쓰이며 카카오 등록 템플릿의 버튼 도메인과
#   정확히 일치해야 한다(끝 슬래시 없이). 미설정 시 localhost 로 발송되는 사고가 나므로 staging/prod 필수.
# FRONTEND_BASE_URL=http://localhost:3001
# FRONTEND_LOGIN_CALLBACK_URL=http://localhost:3001/login/callback
# ADMIN_BASE_URL: 운영자 어드민 웹 origin.
# ADMIN_BASE_URL=http://localhost:3001/admin
# APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*
# 리프레시 토큰 쿠키 Secure 속성(HTTPS 전용). prod=true.
APP_COOKIE_SECURE=false
# 리프레시 토큰 쿠키 Path. 바꿀 땐 브라우저가 보는 경로 기준이다(프론트 프록시 경유면 /api/backend/v1/auth).
# APP_COOKIE_REFRESH_PATH=/

# Redis
# REDIS_HOST=localhost
# REDIS_PORT=6379

# 스케줄러 튜닝 (선택 — 미설정 시 yaml 기본값 사용)
# ⚠️ *_ENABLED 스위치는 값을 채워 둔다 — 빈 값이면 @ConditionalOnProperty 가 매칭되지 않아 스케줄러가 조용히 꺼진다.
# 분철 자동 마감 (cron 매 정각 + fallback 폴링)
BUNCHEOL_AUTO_CLOSE_ENABLED=true
# BUNCHEOL_AUTO_CLOSE_CRON=0 0 * * * *
# BUNCHEOL_AUTO_CLOSE_FALLBACK_INTERVAL_MS=600000
# BUNCHEOL_AUTO_CLOSE_INITIAL_DELAY_MS=10000
# 입금 만료 자동취소 폴링
PAYMENT_EXPIRY_ENABLED=true
# PAYMENT_EXPIRY_INTERVAL_MS=60000
# PAYMENT_EXPIRY_INITIAL_DELAY_MS=10000
# 추적 웹훅 TTL 연장 + 상태 폴링 (기본 12시간 — 웹훅 TTL 48h 의 절반 이하 유지)
TRACKING_REFRESH_ENABLED=true
# TRACKING_REFRESH_INTERVAL_MS=43200000
# TRACKING_REFRESH_INITIAL_DELAY_MS=420000
# 지점 도착 후 미수령 독촉 알림 (매일 정오 일괄 — 도착 후 12h 경과 건에 1회 발송)
# ⚠️ 기본 꺼짐 — ALIGO_TPL_PICKUP_REMINDER_* 승인·설정 후에 true 로 켠다.
#   먼저 켜면 발송 마킹(1회 dedup)만 소진돼 그동안의 미수령 건이 영영 독촉을 못 받는다.
PICKUP_REMINDER_ENABLED=false
# PICKUP_REMINDER_CRON=0 0 12 * * *
# ⚠️ 반드시 단위를 붙일 것(12h, 24h). cron 주기와 세트로 조정 — 매일 1회 실행이면 12h 를 넘기지 말 것
# PICKUP_REMINDER_THRESHOLD=12h

# 카카오 알림톡 (Aligo)
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_KEY=
ALIGO_SENDER=
ALIGO_FAILOVER=false
ALIGO_TEST_MODE=true

# 카카오 알림톡 템플릿 코드 (승인 후 발급)
ALIGO_TPL_PAYMENT_CONFIRMED=
ALIGO_TPL_PAYMENT_EXPIRED=
ALIGO_TPL_BUNCHEOL_CONFIRMED=
ALIGO_TPL_BUNCHEOL_CANCELLED=
ALIGO_TPL_TRACKING_CU=
ALIGO_TPL_TRACKING_GS25=
ALIGO_TPL_PICKUP_REMINDER_CU=
ALIGO_TPL_PICKUP_REMINDER_GS25=
ALIGO_TPL_PAYBACK_COMPLETED=
ALIGO_TPL_PAYBACK_REJECTED=
# C2C 신규 템플릿 — 미설정이면 해당 알림톡 발송을 조용히 건너뛴다(AlimtalkSender 가드)
ALIGO_TPL_C2C_BUNCHEOL_FINALIZED=
ALIGO_TPL_C2C_PAYMENT_EXPIRED=
ALIGO_TPL_C2C_BUNCHEOL_NOT_FINALIZED=
ALIGO_TPL_C2C_PAYMENT_CONFIRMED=
ALIGO_TPL_C2C_BUNCHEOL_CONFIRMED=
ALIGO_TPL_C2C_BUNCHEOL_CANCELLED=
ALIGO_TPL_C2C_BUNCHEOL_FULL=
ALIGO_TPL_C2C_PAYMENT_SENT=

# 슬랙 Incoming Webhook (채널별, SlackChannel enum 과 매칭. 미설정 시 해당 채널 발송 건너뜀)
# ⚠️ 미설정이어도 에러 없이 조용히 건너뛴다 — 알림이 안 오면 여기부터 확인할 것.
SLACK_WEBHOOK_NEW_PARTICIPATION_URL=
SLACK_WEBHOOK_SHIPPING_FEE_PAYBACK_URL=
# 사용자 의견("의견 보내기") 수집 채널. 참여 접수 알림과 같은 슬랙 앱에 웹훅을 추가할 것
# (발신자 이름·아이콘은 앱 설정에서 상속되므로 다른 앱에 붙이면 그 앱 이름으로 온다).
SLACK_WEBHOOK_FEEDBACK_URL=
# AI 개최글 하루 합계 알림 채널 (기준 건수에 닿는 순간 1회, 막지 않음). 비우면 로그 한 줄만 남는다.
SLACK_WEBHOOK_AI_USAGE_URL=

# 의견 보내기 도배 방지 (선택 — 미설정 시 10분 / 주체당 20건 / 전체 60건)
# 비로그인은 프론트 프록시를 거쳐 IP 가 수렴할 수 있어 주체당 한도가 "비로그인 전체 예산"으로 동작한다.
# FEEDBACK_RATE_LIMIT_MAX=20
# FEEDBACK_RATE_LIMIT_GLOBAL_MAX=60
# ⚠️ 반드시 단위를 붙일 것(10m, 30s). 숫자만 쓰면 '분'으로 읽힌다.
# FEEDBACK_RATE_LIMIT_WINDOW=10m

# 오픈 이벤트 배송비 환급(배송비 돌려받기). 이벤트 종료 시 ENABLED=false 로 내린다.
SHIPPING_FEE_PAYBACK_ENABLED=false
# 신청 마감 = 배송 완료 + N일 (기본 7)
# SHIPPING_FEE_PAYBACK_SUBMIT_WINDOW_DAYS=7

# AI 개최글 도우미 — 같은 박스의 AI 엔진 컨테이너(buncheol-easy-ai)를 부른다.
# ⚠️ 세 값이 모두 있어야 켜진다. 하나라도 비면 POST /v1/ai/drafts 는 409 AI-007, 남은 횟수 조회는 enabled=false.
# 엔진 주소는 도커 네트워크 bce-ai 안의 별칭이다 (예: http://ai-worker:8000 — docker-compose.staging.yml 참고).
AI_DRAFT_ENABLED=
AI_WORKER_BASE_URL=
# 엔진 .env 의 INTERNAL_TOKEN 과 같은 값 (헤더 X-Internal-Token 으로만 보낸다)
AI_WORKER_INTERNAL_TOKEN=
# 선택 — 미설정 시 1인 하루 10회 / 숨은 시도 상한 30회 / 하루 합계 알림 100건 / 서버 동시 4건.
# 0·음수는 기동 실패.
# AI_DRAFT_DAILY_LIMIT_PER_USER=10
# AI_DRAFT_DAILY_ATTEMPT_LIMIT_PER_USER=30
# AI_DRAFT_DAILY_ALERT_THRESHOLD=100
# AI_DRAFT_MAX_CONCURRENT=4

# 페이액션 입금 자동확인 (대시보드 > API 에서 발급).
# ⚠️ 세 값이 모두 있어야 연동이 켜진다 — 비워두면 주문 등록·웹훅 수신을 건너뛰고 기존 수동 입금확인으로 동작한다.
# 문제 발생 시 PAYACTION_API_KEY 만 비우고 재시작하면 즉시 원복된다.
# "1초 입금 자동확인 API" 는 프로 플랜(33,000원/월)부터 제공된다.
PAYACTION_API_KEY=
PAYACTION_MALL_ID=
# 수신 웹훅의 발신자 검증용 공유 비밀키. 페이액션 대시보드에 등록할 웹훅 URL 은
# https://<운영 도메인>/v1/deposits/payaction/webhook
PAYACTION_WEBHOOK_KEY=
# 보통 주입 불필요
# PAYACTION_BASE_URL=https://api.payaction.app

# 백엔드 컨테이너 이미지 좌표 (docker-compose.staging.yml 이 요구 — docs/38).
# 배포/롤백 워크플로는 sha- 불변 태그를 셸 env 로 주입한다(셸 env 가 이 값보다 우선).
# 이 값은 박스 수동 조작(up/restart)용 기본값 — staging 박스: ...:staging / prod 박스: ...:prod
BACKEND_IMAGE=

# 관리자 로그인 무차별 대입 방지 (미설정 시 10분 / 로그인 ID당 5회).
# ⚠️ 계정 잠금이라 제3자가 운영자 ID 로 도배하면 잠금 자체가 DoS 가 된다 —
#    윈도우를 짧게 유지해 자동 해제되게 하는 것이 완화책이므로 늘릴 땐 함께 검토할 것.
# ADMIN_LOGIN_RATE_LIMIT_PER_ID=5
# ADMIN_LOGIN_RATE_LIMIT_WINDOW=10m

# 로깅 레벨. 이 프로젝트엔 Spring 프로파일이 없어 application.yaml 이 곧 운영 설정이다 —
# 상세 로그가 필요하면 여기(로컬 .env)에서만 올리고, 배포 박스 .env 에는 넣지 않는다.
# 빈 값은 기동이 실패하지 않고 'Cannot set level ...' ERROR 한 줄만 남긴 뒤 넘어가므로 놓치기 쉽다.
#
# 아래는 로컬 디버깅 권장값 — 주석을 풀어서 쓴다.
# LOG_LEVEL_ROOT 는 프레임워크 내부까지 볼 때만. 기본값 INFO 라 INFO 로 두면 no-op
# LOG_LEVEL_ROOT=DEBUG
# LOG_LEVEL_APP=DEBUG
# LOG_LEVEL_SECURITY=DEBUG
# LOG_LEVEL_SQL 은 org.hibernate.SQL + org.springframework.jdbc.core 동시 적용
# LOG_LEVEL_SQL=DEBUG
