# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Google OAuth (현재 미구현 — application.yaml에 google registration 없음. MVP 이후 검토)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT
JWT_ACCESS_KEY=
JWT_REFRESH_KEY=

# AWS S3
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# Toss Payments
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Delivery Tracker
DELIVERY_TRACKER_CLIENT_ID=
DELIVERY_TRACKER_CLIENT_SECRET=

# Database
# DB_URL: 전체 JDBC URL(호스트 포함). RDS 사용(staging/prod) 시 RDS endpoint로 직접 지정.
#   예) jdbc:mysql://<RDS_ENDPOINT>:3306/<DB_NAME>?serverTimezone=UTC&characterEncoding=UTF-8
#   미설정 시 application.yaml 기본값(localhost)로 fallback 되므로 RDS 환경에서는 반드시 채운다.
DB_URL=
# MYSQL_ROOT_PASSWORD / MYSQL_DATABASE: local Docker Compose(내장 mysql 컨테이너) 전용.
#   staging/prod(RDS)에서는 불필요 — DB 접속은 DB_URL / DB_USERNAME / DB_PASSWORD 로만 한다.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# App Base URL / Frontend Callback / CORS
# 미설정 시 yaml 기본값(localhost)로 조용히 fallback → staging/prod에서는 반드시 실제 도메인 값으로 채운다.
APP_BASE_URL=
FRONTEND_LOGIN_CALLBACK_URL=
APP_CORS_ALLOWED_ORIGIN_PATTERNS=

# Redis
REDIS_HOST=
REDIS_PORT=

# 카카오 알림톡 (Aligo)
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_KEY=
ALIGO_SENDER=
ALIGO_FAILOVER=false
ALIGO_TEST_MODE=true

# 카카오 알림톡 템플릿 코드 (승인 후 발급)
ALIGO_TPL_PARTICIPATION_WON=
ALIGO_TPL_BUNCHEOL_CANCELLED=
ALIGO_TPL_TRACKING_CU=
ALIGO_TPL_TRACKING_GS25=
ALIGO_TPL_PAYMENT_CONFIRMED=
ALIGO_TPL_PAYMENT_DUE_IMMINENT=
ALIGO_TPL_PAYMENT_REPORTED=