# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 카카오 로그인 scope (쉼표 구분, 미설정 시 account_email,openid).
# name·phone_number 는 동의항목 검수 승인 후에만 추가 — 미승인 상태로 추가하면 로그인이 에러 난다.
KAKAO_SCOPES=
# 간편가입 약관 목록의 '마케팅 수신 동의' 항목 태그 (미설정 시 marketing-consent = 콘솔 등록값). 콘솔 등록값과 일치 필수.
KAKAO_MARKETING_TERM_TAG=

# 관리자 계정 부트스트랩 (AdminAccountInitializer — 기동 시 해당 loginId 가 없으면 생성)
# 비밀번호 12자 이상 권장, 72바이트(BCrypt 한계) 이하 필수.
ADMIN_LOGIN_ID=
ADMIN_PASSWORD=

# Google OAuth (미사용 — 2026-07-23 OQ-24 결정: 구글 로그인 미도입, 카카오 단일 운영)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT
JWT_ACCESS_KEY=
JWT_REFRESH_KEY=

# AWS S3
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
S3_BUCKET=

# Delivery Tracker
DELIVERY_TRACKER_CLIENT_ID=
DELIVERY_TRACKER_CLIENT_SECRET=

# Database
# DB_URL: 전체 JDBC URL(호스트 포함). RDS 사용(staging/prod) 시 RDS endpoint로 직접 지정.
#   예) jdbc:mysql://<RDS_ENDPOINT>:3306/<DB_NAME>?serverTimezone=UTC&characterEncoding=UTF-8
#   미설정 시 application.yaml 기본값(localhost)로 fallback 되므로 RDS 환경에서는 반드시 채운다.
DB_URL=
# MYSQL_ROOT_PASSWORD / MYSQL_DATABASE: local Docker Compose(내장 mysql 컨테이너) 전용.
#   staging/prod(RDS)에서는 불필요 — DB 접속은 DB_URL / DB_USERNAME / DB_PASSWORD 로만 한다.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# App Base URL / Frontend Callback / CORS
# 미설정 시 yaml 기본값(localhost)로 조용히 fallback → staging/prod에서는 반드시 실제 도메인 값으로 채운다.
APP_BASE_URL=
# FRONTEND_BASE_URL: 프론트 웹앱 origin. 알림톡 버튼 URL의 base 로 쓰이며 카카오 등록 템플릿의 버튼 도메인과
#   정확히 일치해야 한다(끝 슬래시 없이). 미설정 시 localhost 로 발송되는 사고가 나므로 staging/prod 필수.
FRONTEND_BASE_URL=
FRONTEND_LOGIN_CALLBACK_URL=
# ADMIN_BASE_URL: 운영자 어드민 웹 origin.
ADMIN_BASE_URL=
APP_CORS_ALLOWED_ORIGIN_PATTERNS=
# 리프레시 토큰 쿠키 Secure 속성(HTTPS 전용). prod=true.
APP_COOKIE_SECURE=

# Redis
REDIS_HOST=
REDIS_PORT=

# 스케줄러 튜닝 (선택 — 미설정 시 yaml 기본값 사용)
# 분철 자동 마감 (cron 매 정각 + fallback 폴링)
BUNCHEOL_AUTO_CLOSE_ENABLED=
BUNCHEOL_AUTO_CLOSE_CRON=
BUNCHEOL_AUTO_CLOSE_FALLBACK_INTERVAL_MS=
BUNCHEOL_AUTO_CLOSE_INITIAL_DELAY_MS=
# 입금 만료 자동취소 폴링
PAYMENT_EXPIRY_ENABLED=
PAYMENT_EXPIRY_INTERVAL_MS=
PAYMENT_EXPIRY_INITIAL_DELAY_MS=

# 카카오 알림톡 (Aligo)
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_KEY=
ALIGO_SENDER=
ALIGO_FAILOVER=false
ALIGO_TEST_MODE=true

# 카카오 알림톡 템플릿 코드 (승인 후 발급)
ALIGO_TPL_PAYMENT_CONFIRMED=
ALIGO_TPL_PAYMENT_EXPIRED=
ALIGO_TPL_BUNCHEOL_CONFIRMED=
ALIGO_TPL_BUNCHEOL_CANCELLED=
ALIGO_TPL_TRACKING_CU=
ALIGO_TPL_TRACKING_GS25=
ALIGO_TPL_PAYBACK_COMPLETED=
ALIGO_TPL_PAYBACK_REJECTED=

# 슬랙 Incoming Webhook (채널별, SlackChannel enum 과 매칭. 미설정 시 해당 채널 발송 건너뜀)
SLACK_WEBHOOK_NEW_PARTICIPATION_URL=
SLACK_WEBHOOK_SHIPPING_FEE_PAYBACK_URL=

# 오픈 이벤트 배송비 환급(배송비 돌려받기). 이벤트 종료 시 ENABLED=false 로 내린다.
SHIPPING_FEE_PAYBACK_ENABLED=
# 신청 마감 = 배송 완료 + N일 (기본 7)
SHIPPING_FEE_PAYBACK_SUBMIT_WINDOW_DAYS=
