# Spring Profile (local | dev | prod)
# 미설정 시 application.yaml의 spring.profiles.default = local 적용
SPRING_PROFILES_ACTIVE=

# Database (dev/prod 프로파일에서 사용)
DB_URL=jdbc:mysql://<host>:3306/<db>?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

# Redis (dev/prod 프로파일에서 사용)
REDIS_HOST=
REDIS_PORT=6379

# 애플리케이션 base URL (dev/prod 프로파일에서 사용)
APP_BASE_URL=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT
JWT_ACCESS_KEY=
JWT_REFRESH_KEY=

# AWS S3
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# Toss Payments
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Delivery Tracker
DELIVERY_TRACKER_CLIENT_ID=
DELIVERY_TRACKER_CLIENT_SECRET=
DELIVERY_TRACKER_CALLBACK_URL=
