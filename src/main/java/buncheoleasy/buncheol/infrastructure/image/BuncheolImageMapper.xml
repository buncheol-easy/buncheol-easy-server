<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="buncheoleasy.buncheol.infrastructure.image.BuncheolImageMapper">

    <!-- 분철 이미지 일괄 저장 -->
    <insert id="insertAll">
        INSERT INTO buncheol_images (
                buncheol_id,
                image_url,
                created_at
        ) VALUES
        <foreach collection="buncheolImages" item="buncheolImage" separator=",">
            (
             #{buncheolImage.buncheolId},
             #{buncheolImage.imageUrl},
             NOW()
            )
        </foreach>
    </insert>

</mapper>
