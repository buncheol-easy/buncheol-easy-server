<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="buncheoleasy.group.infrastructure.member.GroupMemberMapper">

    <!-- 해당 그룹 내 멤버 ID 목록 조회 (검증 + 이름 스냅샷용) -->
    <select id="selectAllByGroupIdAndIds" resultType="GroupMember">
        SELECT id, group_id, name, created_at, updated_at
        FROM group_members
        WHERE group_id = #{groupId}
          AND id IN
        <foreach collection="memberIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 특정 그룹의 멤버 전체 조회 -->
    <select id="selectAllByGroupId" resultType="GroupMember">
        SELECT id, group_id, name, created_at, updated_at
        FROM group_members
        WHERE group_id = #{groupId}
    </select>

</mapper>
