<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="buncheoleasy.buncheol.infrastructure.member.BuncheolMemberMapper">

  <!-- 분철 멤버 일괄 저장 -->
  <insert id="insertAll">
    INSERT INTO buncheol_members (
    buncheol_id,
    member_id,
    member_name,
    instant_price,
    bid_allowed,
    bid_min_price,
    created_at,
    updated_at
    )
    VALUES
    <foreach collection="buncheolMembers" item="buncheolMember" separator=",">
      (
      #{buncheolMember.buncheolId},
      #{buncheolMember.memberId},
      #{buncheolMember.memberName},
      #{buncheolMember.instantPrice},
      #{buncheolMember.bidOption.bidAllowed},
      #{buncheolMember.bidOption.bidMinPrice},
      NOW(),
      NOW()
      )
    </foreach>
  </insert>

  <!-- 분철 멤버 전체 삭제 -->
  <delete id="deleteAllByBuncheolId">
    DELETE
    FROM buncheol_members
    WHERE buncheol_id = #{buncheolId}
  </delete>

  <!-- 분철 멤버 단건 조회 (id + buncheolId) -->
  <resultMap id="buncheolMemberResultMap" type="BuncheolMember">
    <constructor>
      <idArg column="id" javaType="Long"/>
      <arg column="buncheol_id" javaType="Long"/>
      <arg column="member_id" javaType="Long"/>
      <arg column="member_name" javaType="String"/>
      <arg column="instant_price" javaType="_long"/>
      <arg column="bid_allowed" javaType="_boolean"/>
      <arg column="bid_min_price" javaType="Long"/>
      <arg column="created_at" javaType="java.time.LocalDateTime"/>
      <arg column="updated_at" javaType="java.time.LocalDateTime"/>
    </constructor>
  </resultMap>

  <select id="findByIdAndBuncheolId" resultMap="buncheolMemberResultMap">
    SELECT id,
           buncheol_id,
           member_id,
           member_name,
           instant_price,
           bid_allowed,
           bid_min_price,
           created_at,
           updated_at
    FROM buncheol_members
    WHERE id = #{id}
      AND buncheol_id = #{buncheolId}
  </select>

</mapper>
